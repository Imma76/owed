# Copy to .env.local and fill in. Never commit .env.local.

# developer.paypal.com → Apps & Credentials → Sandbox → Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# developer.paypal.com → Testing Tools → Sandbox Accounts → the *Personal* account's email
# (this plays the client who receives and pays invoices in the demo)
SANDBOX_CLIENT_EMAIL=

# Shown on invoices
OWED_BUSINESS_NAME=Owed Demo Studio

# platform.openai.com → API keys
OPENAI_API_KEY=
# Optional: override the model (default gpt-5.5)
OPENAI_MODEL=
